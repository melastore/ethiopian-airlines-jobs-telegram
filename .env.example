# Create a bot with @BotFather, add it as an admin of your channel, then fill these in.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_token
TELEGRAM_CHAT_ID=@your_channel_username

DATABASE_PATH=data/jobs.db

# Every two hours, every day.
SCHEDULE_TIMEZONE=Africa/Addis_Ababa
ACTIVE_HOURS=0-23
ACTIVE_DAYS=mon-sun
CHECK_EVERY_HOURS=2

REQUEST_TIMEOUT_SECONDS=30
SEND_GAP_SECONDS=3.5

# Refuse to send more than this in one run. Guards against a lost history.
MAX_POSTS_PER_RUN=12
LOG_LEVEL=INFO
